{
  "mappings": [
    {
      "name": "create session",
      "request": {
        "method": "POST",
        "url": "/session",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.request == 'test-jwt-success')]" }]
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "session_id": "CAFEBABE",
          "state": "sT@t3",
          "redirect_uri": "{{request.baseUrl}}/callback"
        },
        "transformers": ["response-template"]
      }
    },
    {
      "name": "get authorization code",
      "request": {
        "method": "GET",
        "urlPath": "/authorization",
        "headers": {
          "session_id": {
            "equalTo": "CAFEBABE"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "authorizationCode": {
            "value": "DEADBEEF"
          },
          "redirect_uri": "{{request.baseUrl}}/callback",
          "state": "sT@t3"
        },
        "transformers": ["response-template"]
      }
    },
    {
      "name": "get banks",
      "request": {
        "method": "GET",
        "urlPath": "/banks",
        "headers": {
          "session-id": {
            "equalTo": "CAFEBABE"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "banks": [
            {
              "bankId": "ironforge-vault",
              "friendlyName": "Vault of Ironforge",
              "serviceStatus": true
            },
            {
              "bankId": "org-counting-house",
              "friendlyName": "Orgrimmar Counting House",
              "serviceStatus": true
            },
            {
              "bankId": "royal-bank-sw",
              "friendlyName": "Royal Bank of Stormwind",
              "serviceStatus": true
            },
            {
              "bankId": "forgotten-uldaman-vault",
              "friendlyName": "Forgotten Vault of Uldaman",
              "serviceStatus": false
            }
          ],
          "profile": "STUB",
          "refreshedAtSeconds": 690768000
        }
      }
    },
    {
      "name": "create consent",
      "request": {
        "method": "POST",
        "urlPath": "/consent",
        "headers": {
          "session-id": {
            "equalTo": "CAFEBABE"
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "bank_consent_url": "http://{{systemValue type='ENVIRONMENT' key='CRI_BIND_HOST'}}:{{systemValue type='ENVIRONMENT' key='CRI_PORT'}}/stubs/webhook",
          "bank_id": "ironforge-vault",
          "id": "CONSENT-SUCCESS-UUID",
          "redirect_url": "http://{{systemValue type='ENVIRONMENT' key='CRI_BIND_HOST'}}:{{systemValue type='ENVIRONMENT' key='CRI_PORT'}}/confirm-details-bank",
          "url_expiry_seconds": 300
        },
        "transformers": ["response-template"]
      }
    },
    {
      "name": "oauth callback",
      "request": {
        "method": "GET",
        "urlPath": "/callback",
        "queryParameters": {
          "code": {
            "equalTo": "DEADBEEF"
          },
          "state": {
            "equalTo": "sT@t3"
          },
          "client_id": {
            "equalTo": "test-client"
          }
        }
      },
      "response": {
        "status": 200,
        "body": "OAuth callback received successfully"
      }
    }
  ]
}
